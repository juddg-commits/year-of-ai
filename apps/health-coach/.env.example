# Copy this file to .env and paste your real keys (never commit .env).
# On a server (Railway etc.), set these as environment variables instead.

# Required. Get a key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: in-app form videos. Needs a Google Cloud API key starting with AIza
# (NOT an AI Studio "AQ." key). console.cloud.google.com → new project →
# enable "YouTube Data API v3" → Credentials → Create credentials → API key.
YOUTUBE_API_KEY=

# Deploy only: set a password so only you can use the app (and your API credits).
# Leave empty for local use.
APP_PASSWORD=

# Deploy only: your timezone, so "today" matches your day, not the server's (UTC).
TZ=America/Detroit

# Deploy only: where logs live. Point at a persistent volume (e.g. /data).
# Leave empty locally to use ./data.
DATA_DIR=
